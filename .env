
OPENAQ_API_KEY=

# URL de base de l'API (au cas où elle change)
OPENAQ_BASE_URL=https://api.openaq.org/v2

OPENAQ_DEFAULT_COUNTRY=TG
OPENAQ_DEFAULT_CITY=Lomé
DEFAULT_PARAMETERS=pm25,pm10

MAX_RESULTS_PER_REQUEST=1000

COLLECTION_INTERVAL_MINUTES=30

# Activer/désactiver la collecte automatique au démarrage
AUTO_START_COLLECTION=true


ENVIRONMENT=development

# Port de l'API FastAPI
API_PORT=8000

# Niveau de logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

SECRET_KEY=

# Autoriser CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

HTTP_TIMEOUT=30

MAX_RETRIES=3

RETRY_DELAY=5